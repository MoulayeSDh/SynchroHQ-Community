# Application
APP_NAME=SynchroHQ
APP_ENV=development
# Synthetic local accounts only; ignored outside development.
DEMO_LOGIN_ENABLED=false
LOG_LEVEL=INFO

# Backend FastAPI
API_HOST=0.0.0.0
API_PORT=8001
API_HOST_PORT=8001
API_BASE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Frontend Next.js — seules les variables NEXT_PUBLIC_* sont exposées au navigateur
NEXT_PUBLIC_APP_NAME=SynchroHQ
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_SUPPORTED_LOCALES=fr,ar,en

# PostgreSQL — valeurs locales d'exemple uniquement
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434
POSTGRES_DB=synchrohq
POSTGRES_USER=synchrohq
POSTGRES_PASSWORD=
# Facultatif : remplace les variables PostgreSQL ci-dessus.
DATABASE_URL=

# Authentification Community JWT — remplacer obligatoirement hors développement
AUTH_JWT_SECRET=
AUTH_ISSUER=synchrohq-community
AUTH_AUDIENCE=synchrohq-api
OFFLINE_GRANT_AUDIENCE=synchrohq-offline-drafts
OFFLINE_EDIT_SECONDS=86400

# Pièces jointes — MinIO local ou stockage objet compatible S3
ATTACHMENT_MAX_BYTES=10485760
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=synchrohq
S3_ACCESS_KEY=synchrohq_dev
S3_SECRET_KEY=
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Les intégrations OIDC, IA et traitements asynchrones seront
# documentées dans les phases où elles deviennent réellement utilisées.

# Forms Engine — limites V1
FORM_SCHEMA_MAX_BYTES=262144
FORM_SCHEMA_MAX_DEPTH=12
FORM_SCHEMA_MAX_FIELDS=200
FORM_ARRAY_MAX_ITEMS=100
FORM_ANSWERS_MAX_BYTES=1048576
