{
  "schema_version": "synchrohq.form/v1",
  "data_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "report_date",
      "situation_level",
      "executive_summary",
      "activities",
      "needs_support",
      "author_declaration"
    ],
    "properties": {
      "report_date": {
        "type": "string",
        "format": "date"
      },
      "situation_level": {
        "type": "string",
        "enum": [
          "NORMAL",
          "WATCH",
          "CRITICAL"
        ]
      },
      "executive_summary": {
        "type": "string",
        "minLength": 20,
        "maxLength": 4000
      },
      "activities": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
          "type": "object",
          "required": [
            "category",
            "description",
            "occurred_at"
          ],
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "ADMINISTRATION",
                "PUBLIC_SERVICE",
                "FIELD_ACTIVITY",
                "INCIDENT",
                "OTHER"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 5,
              "maxLength": 2000
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time"
            },
            "quantity": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            },
            "location": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "latitude",
                "longitude"
              ],
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "accuracy_meters": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "difficulties": {
        "type": "string",
        "maxLength": 3000
      },
      "needs_support": {
        "type": "boolean"
      },
      "support_request": {
        "type": "string",
        "minLength": 10,
        "maxLength": 2000
      },
      "attachments": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "required": [
            "attachment_id",
            "file_name",
            "mime_type",
            "size",
            "sha256"
          ],
          "properties": {
            "attachment_id": {
              "type": "string",
              "format": "uuid"
            },
            "file_name": {
              "type": "string",
              "maxLength": 255
            },
            "mime_type": {
              "type": "string",
              "enum": [
                "image/jpeg",
                "image/png",
                "application/pdf"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10485760
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "author_declaration": {
        "type": "boolean",
        "const": true
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "needs_support": {
              "const": true
            }
          },
          "required": [
            "needs_support"
          ]
        },
        "then": {
          "required": [
            "support_request"
          ]
        }
      }
    ],
    "additionalProperties": false
  },
  "ui_schema": {
    "title_key": "form.title",
    "description_key": "form.description",
    "fields": {
      "/report_date": {
        "widget": "date",
        "label_key": "/report_date.label"
      },
      "/situation_level": {
        "widget": "select",
        "label_key": "/situation_level.label",
        "options": {
          "NORMAL": "/situation_level.option.NORMAL",
          "WATCH": "/situation_level.option.WATCH",
          "CRITICAL": "/situation_level.option.CRITICAL"
        }
      },
      "/executive_summary": {
        "widget": "textarea",
        "label_key": "/executive_summary.label"
      },
      "/activities": {
        "widget": "repeating-group",
        "label_key": "/activities.label"
      },
      "/activities/*/category": {
        "widget": "select",
        "label_key": "/activities/*/category.label",
        "options": {
          "ADMINISTRATION": "activity.category.ADMINISTRATION",
          "PUBLIC_SERVICE": "activity.category.PUBLIC_SERVICE",
          "FIELD_ACTIVITY": "activity.category.FIELD_ACTIVITY",
          "INCIDENT": "activity.category.INCIDENT",
          "OTHER": "activity.category.OTHER"
        }
      },
      "/activities/*/description": {
        "widget": "textarea",
        "label_key": "/activities/*/description.label"
      },
      "/activities/*/occurred_at": {
        "widget": "datetime",
        "label_key": "/activities/*/occurred_at.label"
      },
      "/activities/*/quantity": {
        "widget": "decimal",
        "label_key": "/activities/*/quantity.label"
      },
      "/activities/*/unit": {
        "widget": "text",
        "label_key": "/activities/*/unit.label"
      },
      "/activities/*/location": {
        "widget": "gps",
        "label_key": "/activities/*/location.label"
      },
      "/activities/*/location/latitude": {
        "widget": "decimal",
        "label_key": "/activities/*/location/latitude.label"
      },
      "/activities/*/location/longitude": {
        "widget": "decimal",
        "label_key": "/activities/*/location/longitude.label"
      },
      "/activities/*/location/accuracy_meters": {
        "widget": "decimal",
        "label_key": "/activities/*/location/accuracy_meters.label"
      },
      "/difficulties": {
        "widget": "textarea",
        "label_key": "/difficulties.label"
      },
      "/needs_support": {
        "widget": "boolean",
        "label_key": "/needs_support.label"
      },
      "/support_request": {
        "widget": "textarea",
        "label_key": "/support_request.label",
        "visible_when": {
          "path": "/needs_support",
          "equals": true
        }
      },
      "/attachments": {
        "widget": "attachments-metadata",
        "label_key": "/attachments.label"
      },
      "/attachments/*/attachment_id": {
        "widget": "text",
        "label_key": "/attachments/*/attachment_id.label"
      },
      "/attachments/*/file_name": {
        "widget": "text",
        "label_key": "/attachments/*/file_name.label"
      },
      "/attachments/*/mime_type": {
        "widget": "select",
        "label_key": "/attachments/*/mime_type.label"
      },
      "/attachments/*/size": {
        "widget": "integer",
        "label_key": "/attachments/*/size.label"
      },
      "/attachments/*/sha256": {
        "widget": "text",
        "label_key": "/attachments/*/sha256.label"
      },
      "/author_declaration": {
        "widget": "boolean",
        "label_key": "/author_declaration.label"
      }
    },
    "order": {
      "": [
        "report_date",
        "situation_level",
        "executive_summary",
        "activities",
        "difficulties",
        "needs_support",
        "support_request",
        "attachments",
        "author_declaration"
      ],
      "/activities/*": [
        "category",
        "description",
        "occurred_at",
        "quantity",
        "unit",
        "location"
      ],
      "/activities/*/location": [
        "latitude",
        "longitude",
        "accuracy_meters"
      ],
      "/attachments/*": [
        "attachment_id",
        "file_name",
        "mime_type",
        "size",
        "sha256"
      ]
    }
  },
